<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="LetCode Test Suite" verbose="1" parallel="tests" thread-count="2">

    <!-- Smoke Group (Critical, Important Flows) -->
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.letcode.forms.tests.FormsPageTest"/>
            <class name="com.letcode.alert.tests.AcceptSimpleAlertTest"/>
            <class name="com.letcode.alert.tests.DismissConfirmAlertTest"/>
            <class name="com.letcode.alert.tests.PromptAlertTypeNameTest"/>
            <class name="com.letcode.alert.tests.SweetAlertTest"/>
            <class name="com.letcode.button.tests.ClickButtonTest"/>
            <class name="com.letcode.button.tests.ConfirmButtonIsDisabledTest"/>
            <class name="com.letcode.input.tests.InputFieldSendKeysTest"/>
            <class name="com.letcode.radio.tests.RememberMeCheckboxTest"/>
        </classes>
    </test>

    <!-- Sanity Group (Business Core / Logic) -->
    <test name="Sanity Tests">
        <groups>
            <run>
                <include name="sanity"/>
            </run>
        </groups>
        <classes>
            <class name="com.letcode.file.tests.UploadFileTest"/>
            <class name="com.letcode.table.tests.AttendanceTableTest"/>
            <class name="com.letcode.table.tests.TotalPriceMatchesCalculatedSumTest"/>
            <class name="com.letcode.calender.tests.CalendarBirthdayTest"/>
            <class name="com.letcode.select.tests.CountrySelectionFromDropdownTest"/>
            <class name="com.letcode.select.tests.ProgrammingLanguageDropdownTest"/>
            <class name="com.letcode.radio.tests.YesNoRadioButtonTest"/>
            <class name="com.letcode.multiselect.tests.MultiSelectPageTest"/>
        </classes>
    </test>

    <!-- Regression Group (Remaining Tests) -->
    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.letcode.advancetable.tests.AdvanceTableSearchTest"/>
            <class name="com.letcode.advancetable.tests.PaginationTest"/>
            <class name="com.letcode.button.tests.ClickAndHoldButtonTest"/>
            <class name="com.letcode.button.tests.FindButtonHeightAndWidthTest"/>
            <class name="com.letcode.button.tests.FindTheButtonColorTest"/>
            <class name="com.letcode.button.tests.GetTheXandYCoordinatesTest"/>
            <class name="com.letcode.drag.tests.DragPageTest"/>
            <class name="com.letcode.elements.tests.ElementsPageTest"/>
            <class name="com.letcode.input.tests.InputFieldClearTest"/>
            <class name="com.letcode.input.tests.InputFieldGetAttributeTest"/>
            <class name="com.letcode.input.tests.InputFieldIsEnabledTest"/>
            <class name="com.letcode.input.tests.InputFieldKeyboardTabTest"/>
            <class name="com.letcode.input.tests.InputFieldReadOnlyTest"/>
            <class name="com.letcode.select.tests.SelectFruitByVisibleTextTest"/>
            <class name="com.letcode.select.tests.SelectYourSuperHerosTest"/>
            <class name="com.letcode.slider.tests.SliderBarMoveTest"/>
            <class name="com.letcode.radio.tests.AcceptTermsAndConditionsTest"/>
            <class name="com.letcode.radio.tests.ConfirmLastRadioButtonDisabledTest"/>
            <class name="com.letcode.radio.tests.ConfirmRadioButtonTest"/>
            <class name="com.letcode.radio.tests.PreSelectedRadioButtonTest"/>
            <class name="com.letcode.window.tests.MultipleWindowsHandlingTest"/>
            <class name="com.letcode.window.tests.WindowHandlingTest"/>
        </classes>
    </test>

</suite>

